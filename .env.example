# Riot API: never expose this through VITE_* or browser code.
RIOT_API_KEY=RGAPI-your-key-here
RIOT_PLATFORM=vn2
RIOT_REGION=sea
RIOT_MAX_PLAYERS=24
RIOT_MATCHES_PER_PLAYER=12
RIOT_REQUEST_DELAY_MS=1250

# Optional source tuning. 0 disables a source without deleting its adapter.
HEXCOACH_WEIGHT_RIOT=1.00
HEXCOACH_WEIGHT_METATFT=0.90
HEXCOACH_WEIGHT_LOLCHESS=0.70
HEXCOACH_WEIGHT_TACTICSTOOLS=0.70
HEXCOACH_WEIGHT_KR=0.75
HEXCOACH_WEIGHT_CN=0.65

HEXCOACH_MODEL=backend/models/board_ranker.keras
HEXCOACH_ITEM_MODEL=backend/models/item_ranker.keras
HEXCOACH_ITEM_AFFINITY_MODEL=backend/models/item_affinity_ranker.keras
HEXCOACH_ITEM_PAIR_MODEL=backend/models/item_pair_ranker.keras
HEXCOACH_POSITION_MODEL=backend/models/position_ranker.keras
HEXCOACH_REROLL_MODEL=backend/models/reroll_ranker.keras
HEXCOACH_STAR_MODEL=backend/models/star_ranker.keras
